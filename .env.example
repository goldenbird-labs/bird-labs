# Copy to .env for local development. On Hostinger, add these under
# Websites → your Node.js app → Environment variables.

# ── Required ──────────────────────────────────────────────────────────────
# Password for the admin dashboard at /admin
ADMIN_PASSWORD=

# MySQL database for leads and analytics (create one in hPanel → Databases → MySQL).
# Without it the app falls back to files in ./data, which can be lost on redeploy.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# OpenAI key for Birdie, the website chatbot. Without it the chat shows a "contact us" fallback.
OPENAI_API_KEY=
# Optional model override (default gpt-4o)
GPT_MODEL=

# ── Optional: extra copies of each lead ───────────────────────────────────
# Pushover phone notifications
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Google Sheets (service account JSON pasted on one line, or a path to the file)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_SHEET_ID=
# Defaults to Sheet1!A:M
GOOGLE_SHEET_RANGE=

# Follow-up email to people who leave details in the chatbot (Resend, verified domain)
RESEND_API_KEY=
EMAIL_FROM=Bird Labs <hello@birdlabs.net>

# ── Optional: other settings ──────────────────────────────────────────────
# Time zone the dashboard counts days in (default America/Toronto)
ANALYTICS_TZ=America/Toronto
# Secret for admin sessions (defaults to one derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=
PORT=3001
